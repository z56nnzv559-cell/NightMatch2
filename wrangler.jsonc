{
  "name": "nightmatch2",
  "main": "src/runtime-entry.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "akari"
    }
  ],

  "r2_buckets": [
    {
      "binding": "ORIGINALS",
      "bucket_name": "akari-originals"
    },
    {
      "binding": "KYC_DOCS",
      "bucket_name": "akari-kyc"
    }
  ],

  "kv_namespaces": [
    { "binding": "CACHE" }
  ],

  "images": { "binding": "IMAGES" },

  "durable_objects": {
    "bindings": [
      { "name": "TRIAL_CODE", "class_name": "TrialCode" },
      { "name": "CONVERSATION", "class_name": "Conversation" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TrialCode", "Conversation"]
    }
  ],

  "workflows": [
    {
      "name": "deal-workflow",
      "binding": "DEAL_WORKFLOW",
      "class_name": "DealWorkflow"
    }
  ],

  "queues": {
    "producers": [
      { "binding": "NOTIFY", "queue": "akari-notify" },
      { "binding": "PAYOUT", "queue": "akari-payout" }
    ],
    "consumers": [
      { "queue": "akari-notify", "max_batch_size": 20, "max_retries": 5 },
      {
        "queue": "akari-payout",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "akari-payout-dlq"
      }
    ]
  },

  "triggers": {
    "crons": ["0 19 * * *"]
  },

  "observability": { "enabled": true },

  "vars": {
    "APP_ENV": "production",
    "DEMO_KYC": "true",
    "VAPID_SUBJECT": "mailto:ops@example.jp",
    "ACCESS_TEAM_DOMAIN": "<team>.cloudflareaccess.com",
    "ACCESS_AUD": "<audience-tag>",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEVLG-tRt9YJa7rW"
  }
}
