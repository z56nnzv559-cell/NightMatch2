{
  "name": "akari",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "akari",
      "database_id": "8f4673e1-ca5d-4f48-b92e-004e78189e2f"
      // D1 は単一ロケーション。置き場所は作成時にしか決められないので、
      // ここではなく `wrangler d1 create akari --location apac` で指定する
      // （利用者が国内に集中するので東京寄りに置く）
    }
  ],

  "r2_buckets": [
    {
      // 写真の原本。公開バインドは付けない。配信は Images の派生だけ
      "binding": "ORIGINALS",
      "bucket_name": "akari-originals"
    },
    {
      // 身分証。判定後に消す前提でライフサイクルを短く設定する
      "binding": "KYC_DOCS",
      "bucket_name": "akari-kyc"
    }
  ],

  "kv_namespaces": [
    { "binding": "CACHE", "id": "4f64fc0ec11c420ead07f9e65028190a" }
  ],

  // 写真の派生を作る。原本は R2 に置いたまま、ここを通した結果だけ配信する
  "images": { "binding": "IMAGES" },

  "durable_objects": {
    "bindings": [
      { "name": "TRIAL_CODE", "class_name": "TrialCode" },
      { "name": "CONVERSATION", "class_name": "Conversation" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TrialCode", "Conversation"]
    }
  ],

  "workflows": [
    {
      "name": "deal-workflow",
      "binding": "DEAL_WORKFLOW",
      "class_name": "DealWorkflow"
    }
  ],

  "queues": {
    "producers": [
      { "binding": "NOTIFY", "queue": "akari-notify" },
      { "binding": "PAYOUT", "queue": "akari-payout" }
    ],
    "consumers": [
      { "queue": "akari-notify", "max_batch_size": 20, "max_retries": 5 },
      {
        "queue": "akari-payout",
        "max_batch_size": 1,
        "max_retries": 3,
        // 振込は再送で二重払いになるため、必ず失敗を人が見る
        "dead_letter_queue": "akari-payout-dlq"
      }
    ]
  },

  "triggers": {
    "crons": [
      // 04:00 JST。出勤日数の集計と定着判定。
      // 日本時間の月初に当たった回で、前月ぶんの請求も下書きする
      // （cron の指定は UTC なので「月末の19時」を別に書けない）
      "0 19 * * *"
    ]
  },

  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "akari_events" }
  ],

  "observability": { "enabled": true },

  "vars": {
    "APP_ENV": "production",
    "VAPID_SUBJECT": "mailto:ops@example.jp",
    "ACCESS_TEAM_DOMAIN": "<team>.cloudflareaccess.com",
    "ACCESS_AUD": "<audience-tag>"
  }
  // 秘密は wrangler secret put。Stripe / 振込 / KYC の鍵はここに書かない
}
